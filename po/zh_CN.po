#: src/launcher_editor/ui/window.py:492
msgid "Replace an existing desktop file?"
msgstr "替换已有的桌面文件？"

#: src/launcher_editor/ui/window.py:494
#, python-brace-format
msgid ""
"{path} already exists and was not created by Launcher Editor. Replacing it "
"will overwrite the file."
msgstr "{path} 已存在，且不是由启动器编辑器创建的。替换将覆盖该文件。"

#: src/launcher_editor/ui/window.py:497
msgid "Replace"
msgstr "替换"

#: src/launcher_editor/ui/window.py:499
msgid "Remove a desktop file?"
msgstr "移除桌面文件？"

#: src/launcher_editor/ui/window.py:501
#, python-brace-format
msgid ""
"{path} was not created by Launcher Editor. Removing it will move the file to "
"the trash."
msgstr "{path} 不是由启动器编辑器创建的。移除会把文件放入回收站。"

#: src/launcher_editor/ui/window.py:504
msgid "Remove"
msgstr "移除"

#: src/launcher_editor/ui/window.py:527
msgid "Delete this desktop file?"
msgstr "删除此桌面文件？"

#: src/launcher_editor/ui/window.py:529
msgid ""
"The file will be moved to the trash. It is not part of a launcher entry in "
"your application folder."
msgstr "文件将被放入回收站。它不是应用文件夹中的启动器条目。"

#: src/launcher_editor/ui/window.py:533
#, python-brace-format
msgid "Delete “{name}”?"
msgstr "删除“{name}”？"

#: src/launcher_editor/ui/window.py:535
msgid ""
"The desktop entry will be moved to the trash. This does not uninstall the "
"application. A desktop icon created by Launcher Editor will also be removed."
msgstr ""
"桌面条目将被放入回收站。这不会卸载应用。由启动器编辑器创建的桌面图标也会被移"
"除。"

#: src/launcher_editor/ui/window.py:552 src/launcher_editor/ui/window.py:555
msgid "Could not delete the application"
msgstr "无法删除应用"

#: src/launcher_editor/ui/window.py:557
#, python-brace-format
msgid "Deleted {name}"
msgstr "已删除 {name}"

#: src/launcher_editor/ui/window.py:563
msgid "Could not add the application to the launcher"
msgstr "无法将应用添加到启动器"

#: src/launcher_editor/ui/window.py:565
msgid "Added to the launcher"
msgstr "已添加到启动器"

